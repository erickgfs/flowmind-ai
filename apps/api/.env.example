# Conexão da API com o PostgreSQL do docker-compose.yml (raiz do projeto)
# Usuário/senha/banco são os mesmos de flowmind-ai/.env
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://flowmind:troque_esta_senha@localhost:5432/flowmind?schema=public"

# Porta HTTP da API
PORT=3000
